        },
        "max_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum, metres."
        },
        "success_count": {
          "description": "Solved blips with a diagnostic.",
          "minimum": 0,
          "type": "integer"
        },
        "failed_count": {
          "description": "Solved blips without one.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
