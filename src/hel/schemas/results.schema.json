  "additionalProperties": true,
  "description": "A complete Fenrir results file.",
  "properties": {
    "contract": {
      "const": "hel.results",
      "description": "Contract name; always 'hel.results'.",
      "type": "string"
    },
    "contract_version": {
      "description": "Contract version, MAJOR.MINOR (e.g. '1.0').",
      "type": "string"
    },
    "event_id": {
      "description": "The fall's identifier, as in its event.json.",
      "minLength": 1,
      "type": "string"
    },
    "run": {
      "$ref": "#/$defs/ResultsRunInfo"
    },
    "inputs": {
      "$ref": "#/$defs/AnalysisInputs"
    },
    "terminus": {
      "$ref": "#/$defs/FittedTerminus"
    },
    "search": {
      "anyOf": [
        {
          "$ref": "#/$defs/SearchDiagnostics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "radar_sweeps": {
      "items": {
        "$ref": "#/$defs/RadarSweep"
      },
      "type": "array"
    },
    "blips": {
      "items": {
        "$ref": "#/$defs/BlipResult"
      },
      "type": "array"
    },
    "forensics": {
      "anyOf": [
        {
          "$ref": "#/$defs/Forensics"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Absent when no blip was solved."
    },
    "reverse_offsets": {
      "$ref": "#/$defs/ReverseOffsets"
    },
    "wind_profile": {
      "description": "The wind above the fitted terminus, from the ground up, every 250 m.",
      "items": {
        "$ref": "#/$defs/WindLevel"
      },
      "type": "array"
    },
    "radar_detection_span_s": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Time from the first to the last sweep start in the radar file, s."
    },
    "scattering_model": {
      "$ref": "#/$defs/ScatteringModel"
    },
    "files": {
      "$ref": "#/$defs/OutputFiles"
    }
  },
  "required": [
    "contract",
    "contract_version",
    "event_id",
    "run",
    "inputs",
    "terminus",
    "radar_sweeps",
    "blips",
    "reverse_offsets",
    "wind_profile",
    "scattering_model",
    "files"
  ],
  "type": "object"
}
