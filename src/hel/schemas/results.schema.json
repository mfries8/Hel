    "ResultsRunInfo": {
      "additionalProperties": true,
      "description": "Which run produced the file.",
      "properties": {
        "run_id": {
          "description": "The run's folder identifier.",
          "minLength": 1,
          "type": "string"
        },
        "generated_utc": {
          "description": "When the file was written (UTC).",
          "format": "date-time",
          "type": "string"
        },
        "fenrir_version": {
          "description": "Version of Fenrir that wrote the file.",
          "type": "string"
        },
        "analysis_mode": {
          "description": "Fit mode: 'simple' (the entered terminus), 'algebraic_surrogate', 'centerline_alignment', or 'full_parameter_refinement' (all parameters fitted at once).",
          "enum": [
            "simple",
            "algebraic_surrogate",
            "centerline_alignment",
            "full_parameter_refinement"
          ],
          "type": "string"
        },
        "wind_source": {
          "description": "Wind data used, e.g. 'era5', 'raob' or 'raob_3_avg'.",
          "type": "string"
        },
        "wind_data_flagged": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the wind data were flagged, when the analyst accepted flagged data."
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Random seed of the searches."
        },
        "anchor_blip_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Centerline Alignment's anchor blip, counted among the blips with a mass."
        }
      },
      "required": [
        "run_id",
        "generated_utc",
        "fenrir_version",
        "analysis_mode",
        "wind_source"
      ],
      "title": "ResultsRunInfo",
      "type": "object"
    },
    "ReverseDiagnostic": {
      "additionalProperties": true,
      "description": "A blip's offset carried back to the terminus.\n\nThe fitted mass is flown from the terminus to the blip's altitude; the\nblip's horizontal offset from that crossing, moved to the terminus,\nshows where the terminus would sit to match this blip alone.",
      "properties": {
        "status": {
          "description": "'ok', or why it is missing (e.g. 'missing_mass', 'crossing_state_unavailable').",
          "type": "string"
        },
        "method": {
          "description": "How it was computed, e.g. 'forward_offset_diagnostic'.",
          "type": "string"
        },
        "reference_speed_mps": {
          "description": "Terminus speed used, m/s.",
          "type": "number"
        },
        "lat": {
          "anyOf": [
            {
              "maximum": 90.0,
              "minimum": -90.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Latitude, degrees north (WGS84)."
        },
        "lon": {
          "anyOf": [
            {
              "maximum": 180.0,
              "minimum": -180.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Longitude, degrees east (WGS84)."
        },
        "altitude_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Height above the WGS84 ellipsoid, metres."
        },
        "distance_to_terminus_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Horizontal distance from the fitted terminus, metres."
        },
        "time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Flight time from the terminus to the blip's altitude, s."
        }
      },
      "required": [
        "status",
        "method",
        "reference_speed_mps"
      ],
      "title": "ReverseDiagnostic",
      "type": "object"
    },
    "ReverseOffsets": {
      "additionalProperties": true,
      "description": "Spread of the solved blips' reverse-diagnostic distances to the terminus.",
      "properties": {
        "median_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
