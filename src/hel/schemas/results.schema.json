    "SearchDiagnostics": {
      "additionalProperties": true,
      "description": "Full Parameter Refinement's search diagnostics.",
      "properties": {
        "parameters": {
          "description": "Order of the values in every list below: UTM easting (m), UTM northing (m), altitude (m), azimuth (deg), declination (deg), density (kg/m^3), speed (m/s).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scout_samples": {
          "description": "The Latin-hypercube scout samples, one list per sample, in parameters order.",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "type": "array"
        },
        "scout_costs": {
          "description": "Each scout sample's spline cost, m^2 (summed squared misses).",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "sobol_first_order": {
          "description": "First-order Sobol indices of the cost.",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "sobol_total": {
          "description": "Total-order Sobol indices of the cost.",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "sobol_first_order_conf": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
