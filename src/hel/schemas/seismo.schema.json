{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hel.seismo/1.1",
  "title": "SeismoDocument",
  "$defs": {
    "AltitudeMarker": {
      "additionalProperties": true,
      "description": "A fixed-altitude waypoint (20/30/40/50 km) along the solved trajectory.",
      "properties": {
        "altitude_km": {
          "minimum": 0.0,
          "type": "number"
        },
        "lat": {
          "maximum": 90.0,
          "minimum": -90.0,
          "type": "number"
        },
        "lon": {
          "maximum": 180.0,
          "minimum": -180.0,
          "type": "number"
        },
        "alt_m": {
          "type": "number"
        },
        "time_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "velocity_mps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "extrapolated": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "altitude_km",
        "lat",
        "lon",
        "alt_m"
      ],
      "title": "AltitudeMarker",
      "type": "object"
    },
    "ChannelDetail": {
      "additionalProperties": true,
      "description": "Metadata for one recording channel.",
      "properties": {
        "channel": {
          "type": "string"
        },
        "location": {
          "default": "",
          "type": "string"
        },
        "sample_rate_hz": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "orientation_azimuth_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "orientation_dip_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gain": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "epoch_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "epoch_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "channel"
      ],
      "title": "ChannelDetail",
      "type": "object"
    },
    "DarkFlightTerminus": {
      "additionalProperties": true,
      "description": "Where a fragment of one mass slows to the dark-flight target speed.\n\nLoki reports these per mass as alternative starting points for Fenrir's\ncoarse scan when the true fragment mass is unknown.",
      "properties": {
        "mass_kg": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "lat": {
          "maximum": 90.0,
          "minimum": -90.0,
          "type": "number"
        },
        "lon": {
          "maximum": 180.0,
          "minimum": -180.0,
          "type": "number"
        },
        "alt_m": {
          "type": "number"
        },
        "time_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "velocity_mps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "extrapolated": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "mass_kg",
        "lat",
        "lon",
        "alt_m"
      ],
      "title": "DarkFlightTerminus",
      "type": "object"
    },
    "Detector": {
      "additionalProperties": true,
      "description": "The automatic detector's verdict on a pick.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "method": {
          "default": "",
          "type": "string"
        },
        "features": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "confidence"
      ],
      "title": "Detector",
      "type": "object"
    },
    "Ellipse": {
      "additionalProperties": true,
      "description": "A horizontal 1-sigma error ellipse.",
      "properties": {
        "semi_major_m": {
          "minimum": 0.0,
          "type": "number"
        },
        "semi_minor_m": {
          "minimum": 0.0,
          "type": "number"
        },
        "azimuth_deg": {
          "maximum": 360.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "semi_major_m",
        "semi_minor_m",
        "azimuth_deg"
      ],
      "title": "Ellipse",
      "type": "object"
    },
    "Fragmentation": {
      "additionalProperties": true,
      "description": "One located fragmentation burst.",
      "properties": {
        "id": {
          "type": "string"
        },
        "lat": {
          "maximum": 90.0,
          "minimum": -90.0,
          "type": "number"
        },
        "lon": {
          "maximum": 180.0,
          "minimum": -180.0,
          "type": "number"
        },
        "alt_m": {
          "type": "number"
        },
        "time_utc": {
          "format": "date-time",
          "type": "string"
        },
        "uncertainty": {
          "$ref": "#/$defs/FragmentationUncertainty"
        },
        "supporting_picks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "n_stations": {
          "default": 0,
          "type": "integer"
        },
        "confidence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "relative_energy": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "is_terminal": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "lat",
        "lon",
        "alt_m",
        "time_utc"
      ],
      "title": "Fragmentation",
      "type": "object"
    },
    "FragmentationUncertainty": {
      "additionalProperties": true,
      "description": "Uncertainty of a located fragmentation.",
      "properties": {
        "horizontal_sigma_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "vertical_sigma_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "time_sigma_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ellipse": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ellipse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "FragmentationUncertainty",
      "type": "object"
    },
    "GroundTrackPoint": {
      "additionalProperties": true,
      "description": "One point of the trajectory's ground track.",
      "properties": {
        "lat": {
          "maximum": 90.0,
          "minimum": -90.0,
          "type": "number"
        },
        "lon": {
          "maximum": 180.0,
          "minimum": -180.0,
          "type": "number"
        },
        "t_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "alt_m_above": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "segment": {
          "anyOf": [
            {
              "enum": [
                "constrained",
                "extrapolated"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "horizontal_sigma_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "GroundTrackPoint",
      "type": "object"
    },
    "Instrument": {
      "additionalProperties": true,
      "description": "The station's instrument and its response status.",
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "channels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "response_status": {
          "default": "none",
          "enum": [
            "removed",
            "nominal",
            "none"
          ],
          "type": "string"
        },
        "metadata_quality": {
          "default": "missing",
          "enum": [
            "ok",
            "suspect",
            "missing"
          ],
          "type": "string"
        }
      },
      "title": "Instrument",
      "type": "object"
    },
    "ManifestEntry": {
      "additionalProperties": true,
      "description": "One file of the ``Loki_output/`` bundle, with its integrity hash.",
      "properties": {
        "relative_path": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "relative_path",
        "role",
        "sha256",
        "bytes"
      ],
      "title": "ManifestEntry",
      "type": "object"
    },
    "PathSample": {
      "additionalProperties": true,
      "description": "One sample along the solved trajectory.",
      "properties": {
        "t_utc": {
          "format": "date-time",
          "type": "string"
        },
        "lat": {
          "maximum": 90.0,
          "minimum": -90.0,
          "type": "number"
        },
        "lon": {
          "maximum": 180.0,
          "minimum": -180.0,
          "type": "number"
        },
        "alt_m": {
          "type": "number"
        },
        "velocity_mps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mach": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "t_utc",
        "lat",
        "lon",
        "alt_m"
      ],
      "title": "PathSample",
      "type": "object"
    },
    "Pick": {
      "additionalProperties": true,
      "description": "One approved arrival used in the solve.",
      "properties": {
        "pick_id": {
          "type": "string"
        },
        "station_id": {
          "type": "string"
        },
        "channels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "phase": {
          "default": "unknown",
          "enum": [
            "ballistic",
            "fragmentation",
            "airwave-direct",
            "air-coupled-rayleigh",
            "unknown"
          ],
          "type": "string"
        },
        "path_type": {
          "default": "unknown",
          "enum": [
            "direct",
            "tropospheric",
            "stratospheric",
            "thermospheric",
            "unknown"
          ],
          "type": "string"
        },
        "time_utc": {
          "format": "date-time",
          "type": "string"
        },
        "time_uncertainty_s": {
          "minimum": 0.0,
          "type": "number"
        },
        "back_azimuth_deg": {
          "anyOf": [
            {
              "maximum": 360.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "back_azimuth_uncertainty_deg": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "back_azimuth_ambiguous": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "incidence_deg": {
          "anyOf": [
            {
              "maximum": 180.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "incidence_uncertainty_deg": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rectilinearity": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "amplitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "amplitude_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dominant_freq_hz": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "snr_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detector": {
          "$ref": "#/$defs/Detector"
        },
        "review": {
          "$ref": "#/$defs/Review"
        },
        "predicted": {
          "anyOf": [
            {
              "$ref": "#/$defs/PickPrediction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "associated_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "pick_id",
        "station_id",
        "time_utc",
        "time_uncertainty_s",
        "detector"
      ],
      "title": "Pick",
      "type": "object"
    },
    "PickPrediction": {
      "additionalProperties": true,
      "description": "What the solved trajectory predicts for one pick.",
      "properties": {
        "time_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "residual_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "celerity_mps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_point": {
          "anyOf": [
            {
              "$ref": "#/$defs/PointTime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "turning_height_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ground_distance_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "slant_distance_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "path_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "PickPrediction",
      "type": "object"
    },
    "PointTime": {
      "additionalProperties": true,
      "description": "A point in space and (optionally) time.",
      "properties": {
        "lat": {
          "maximum": 90.0,
          "minimum": -90.0,
          "type": "number"
        },
        "lon": {
          "maximum": 180.0,
          "minimum": -180.0,
          "type": "number"
        },
        "alt_m": {
          "description": "Altitude above mean sea level, metres.",
          "type": "number"
        },
        "time_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "lat",
        "lon",
        "alt_m"
      ],
      "title": "PointTime",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": true,
      "description": "What Loki looked up: data centres, atmosphere and ray tracing.",
      "properties": {
        "fdsn": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "atmosphere": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ray_tracer": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_config": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "Review": {
      "additionalProperties": true,
      "description": "The analyst's review of a pick.",
      "properties": {
        "status": {
          "default": "pending",
          "enum": [
            "approved",
            "rejected",
            "auto",
            "pending"
          ],
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reviewed_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Review",
      "type": "object"
    },
    "RunInfo": {
      "additionalProperties": true,
      "description": "What is needed to reproduce the Loki run.",
      "properties": {
        "invocation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rng_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stage_timestamps": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "config": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "title": "RunInfo",
      "type": "object"
    },
    "SeismoLuminousEnd": {
      "additionalProperties": true,
      "description": "Loki's form of the luminous-flight end (the inversion prior).",
      "properties": {
        "time_utc": {
          "format": "date-time",
          "type": "string"
        },
        "lat": {
          "maximum": 90.0,
          "minimum": -90.0,
          "type": "number"
        },
        "lon": {
          "maximum": 180.0,
          "minimum": -180.0,
          "type": "number"
        },
        "altitude_m": {
          "description": "Altitude above mean sea level, metres.",
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "speed_mps": {
          "description": "Speed at the luminous-flight end, m/s.",
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "azimuth_deg": {
          "description": "Direction of travel, degrees clockwise from north.",
          "maximum": 360.0,
          "minimum": 0.0,
          "type": "number"
        },
        "declination_deg": {
          "description": "Degrees below horizontal.",
          "maximum": 90.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "time_utc",
        "lat",
        "lon",
        "altitude_m",
        "speed_mps",
        "azimuth_deg",
        "declination_deg"
      ],
      "title": "SeismoLuminousEnd",
      "type": "object"
    },
    "SeismoStation": {
      "additionalProperties": true,
      "description": "One discovered seismic or infrasound station.",
      "properties": {
        "id": {
          "type": "string"
        },
        "network": {
          "type": "string"
        },
        "station": {
          "type": "string"
        },
        "location": {
          "default": "",
          "type": "string"
        },
        "lat": {
          "maximum": 90.0,
          "minimum": -90.0,
          "type": "number"
        },
        "lon": {
          "maximum": 180.0,
          "minimum": -180.0,
          "type": "number"
        },
